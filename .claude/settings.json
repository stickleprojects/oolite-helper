{
    "permissions": {
        "allow": [
            "Bash(gh pr checks:*)",
            "Bash(gh pr view:*)",
            "Bash(gh run list:*)",
            "Bash(gh run view:*)"
        ]
    },
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Edit|Write|MultiEdit|NotebookEdit",
                "hooks": [
                    { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/lock-tests.sh" }
                ]
            }
        ]
    }
}
